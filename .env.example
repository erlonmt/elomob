APP_NAME=ELOMOB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Without Docker, the Next.js proxy reaches the API from this machine.
TRUSTED_PROXIES=127.0.0.1
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elomob
DB_USERNAME=elomob
DB_PASSWORD=elomob_local
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
BOOST_ENABLED=false
